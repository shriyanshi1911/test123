Sample Backend (Node.js API):

const express = require('express');
const mysql = require('mysql');
const multer = require('multer');
const app = express();

// Database connection
const db = mysql.createConnection({
  host: 'localhost',
  user: 'root',
  password: '',
  database: 'hospital_portal'
});

// File upload setup
const storage = multer.diskStorage({
  destination: function (req, file, cb) {
    cb(null, 'uploads/');
  },
  filename: function (req, file, cb) {
    cb(null, file.fieldname + '-' + Date.now());
  }
});
const upload = multer({ storage: storage });

// Doctor uploads report
app.post('/upload-report', upload.single('report'), (req, res) => {
  const patientId = req.body.patient_id;
  const reportFile = req.file.path;
  
  const query = INSERT INTO reports (patient_id, report_file, date_uploaded) VALUES (?, ?, NOW());
  db.query(query, [patientId, reportFile], (err, result) => {
    if (err) throw err;
    res.send('Report uploaded successfully.');
  });
});

// Patient views reports
app.get('/reports/:patient_id', (req, res) => {
  const patientId = req.params.patient_id;
  
  const query = SELECT * FROM reports WHERE patient_id = ?;
  db.query(query, [patientId], (err, results) => {
    if (err) throw err;
    res.json(results);
  });
});

app.listen(3000, () => {
  console.log('Server started on http://localhost:3000');
});
